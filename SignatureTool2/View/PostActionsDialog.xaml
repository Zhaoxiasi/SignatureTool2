<Window x:Class="SignatureTool2.View.PostActionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打包后处理" Width="560" Height="520"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <Button DockPanel.Dock="Bottom" Content="确定" Padding="14,5" Margin="0,10,0,0"
                HorizontalAlignment="Right" IsDefault="True" Click="OnConfirm" />
        <StackPanel>
            <CheckBox IsChecked="{Binding VerifySign}" Content="打包后校验目标目录是否全部已签名" Margin="0,0,0,10" />
            <TextBlock Text="拷贝到本地目录（每行一个）：" />
            <TextBox MinHeight="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" VerticalContentAlignment="Top"
                     Text="{Binding CopyTargets, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
            <TextBlock Text="上传到 FTP 服务器（每行一个，支持 ftp://user:pass@host/path）：" />
            <TextBox MinHeight="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" VerticalContentAlignment="Top"
                     Text="{Binding FtpTargets, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4" />
            <TextBlock Foreground="#888888" TextWrapping="Wrap"
                       Text="说明：以上动作在压缩包生成后按顺序执行（校验签名 → 本地拷贝 → FTP 上传），上传的是压缩包文件。若签名后未选择打包压缩，则只执行签名校验。" />
        </StackPanel>
    </DockPanel>
</Window>
