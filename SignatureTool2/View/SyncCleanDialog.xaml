<Window x:Class="SignatureTool2.View.SyncCleanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="严格同步 - 确认清理" Width="640" Height="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="全部保留" Padding="10,4" Margin="0,0,10,0" Click="OnKeepAll" />
            <Button Content="全部删除" Padding="10,4" Margin="0,0,10,0" Click="OnDeleteAll" />
            <Button Content="确认清理" Padding="10,4" Margin="0,0,10,0" IsDefault="True" Click="OnConfirm" />
            <Button Content="取消" Padding="10,4" IsCancel="True" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="以下文件存在于目标目录、但源目录中已没有。未勾选“保留”的文件将被删除：" />
        <ListBox ItemsSource="{Binding Items}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsKeep}" VerticalContentAlignment="Center">
                        <TextBlock Text="{Binding FileName}" ToolTip="{Binding FilePath}" />
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
